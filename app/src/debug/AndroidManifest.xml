<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <activity
            android:name="eu.darken.capod.debug.l2cap.L2capPocActivity"
            android:exported="true"
            android:label="L2CAP PoC">
            <intent-filter>
                <action android:name="eu.darken.capod.L2CAP_POC" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <receiver
            android:name="eu.darken.capod.debug.popup.DebugPopUpReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="eu.darken.capod.DEBUG_POPUP_SHOW" />
                <action android:name="eu.darken.capod.DEBUG_POPUP_HIDE" />
                <action android:name="eu.darken.capod.DEBUG_POPUP_RESHOW" />
                <action android:name="eu.darken.capod.DEBUG_POPUP_FLASH" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
